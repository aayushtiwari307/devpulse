# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devpulse?retryWrites=true&w=majority

# GitHub OAuth App credentials (create at github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# Session
SESSION_SECRET=your_super_secret_session_key_change_this

# GitHub Webhook secret (set when registering webhook on GitHub)
WEBHOOK_SECRET=your_webhook_secret

# App
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Upstash Redis (free database at upstash.com, REST API tab)
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
